# OpenHeadscaleGUI – /etc/ohg/ohg.env
# Änderungen werden mit "systemctl restart ohg" übernommen.

# Domain der Verwaltungsoberfläche (DNS A/AAAA-Eintrag muss auf diesen Server zeigen)
OHG_ADMIN_DOMAIN=admin.example.com

# E-Mail für Let's Encrypt (Ablaufwarnungen)
OHG_ACME_EMAIL=admin@example.com

# TLS: acme (Let's Encrypt, Standard) | selfsigned (Test) | off (hinter eigenem TLS-Proxy)
OHG_TLS_MODE=acme
# Für Tests ohne Rate-Limits: https://acme-staging-v02.api.letsencrypt.org/directory
#OHG_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Listener
OHG_HTTPS_ADDR=:443
OHG_HTTP_ADDR=:80

# Datenverzeichnis und Headscale-Binary
OHG_DATA_DIR=/var/lib/ohg
OHG_HEADSCALE_BIN=/usr/local/lib/ohg/headscale

# Admin-Oberfläche nur von diesen Netzen erreichbar (leer = überall).
# Sehr empfohlen, z. B. Büro-IP oder ein Tailnet: 203.0.113.10, 100.64.0.0/10
#OHG_ADMIN_ALLOW_CIDRS=

# Nur setzen, wenn ein eigener Reverse-Proxy davor steht (X-Forwarded-For wird sonst ignoriert)
#OHG_TRUSTED_PROXIES=

# Öffentliche IPs (optional, für die DERP-Map)
#OHG_PUBLIC_IPV4=
#OHG_PUBLIC_IPV6=

# Zwei-Faktor-Anmeldung für alle Benutzer erzwingen
OHG_REQUIRE_2FA=false

# Sitzungen: Leerlauf-Timeout und maximale Dauer
OHG_SESSION_IDLE=30m
OHG_SESSION_MAX=12h

# Ports pro Instanz: Headscale (nur 127.0.0.1) und WireGuard des Server-Nodes (UDP, öffentlich)
OHG_INTERNAL_PORT_BASE=42000
OHG_GATEWAY_PORT_BASE=41641

# debug | info | warn | error
OHG_LOG_LEVEL=info
